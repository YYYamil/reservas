# Archivos de migración/históricos que no deben subirse al repositorio

# Migración desde Google Sheets y herramientas de migración a PostgreSQL
/migracion/
/migrar postgresql/

# Bases de datos SQLite legacy
*.sqlite
*.sqlite3
/data/

# Backups locales de la API (contienen credenciales en config.php)
/api/backups/
/api/config.php

# Configuración local por ambiente (credenciales de cada máquina)
/api/config.local.php

# PID del túnel SSH a Oracle (archivo temporal local)
/.tunel-oracle.pid

# Archivos generados por el sistema operativo
Thumbs.db
.DS_Store

Img/albergues/

# Comprobantes de pago subidos por los clientes (datos personales)
/comprobantes/
