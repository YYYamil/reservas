      "html": "<style>\n  @import url(\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;700&family=Source+Serif+4:opsz,wght@8..60,600&display=swap\");\n\n  :root {\n    --page: #fcf9f2;\n    --surface: #ffffff;\n    --sunken: #f6f0e5;\n    --n300: #d6cbb8;\n    --n500: #8e8474;\n    --n600: #6b6355;\n    --n700: #4c463d;\n    --ink: #2c2622;\n    --accent: #a84c27;\n    --green: #2b5b3e;\n    --danger: #8f3a2b;\n    --danger-soft: #f5dfd8;\n    --ui: \"Manrope\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n    --display: \"Source Serif 4\", Georgia, serif;\n  }\n\n  .campo-label {\n    font-family: var(--ui);\n    font-size: 14px;\n    font-weight: 700;\n    line-height: 1.32;\n    color: var(--ink);\n  }\n\n  .campo-input {\n    width: 100%;\n    height: 48px;\n    padding: 8px 12px;\n    background: var(--surface);\n    border: 1px solid var(--n500);\n    border-radius: 8px;\n    color: var(--ink);\n    font-family: var(--ui);\n    font-size: 16px;\n  }\n\n  .campo-input--error {\n    background: var(--danger-soft);\n    border-color: var(--danger);\n  }\n\n  .campo-ayuda {\n    font-size: 14px;\n    line-height: 1.32;\n    color: var(--n600);\n  }\n\n  .campo-error {\n    display: flex;\n    align-items: flex-start;\n    gap: 4px;\n    font-size: 14px;\n    font-weight: 700;\n    line-height: 1.32;\n    color: var(--danger);\n  }\n</style>\n<div class=\"min-h-screen bg-[var(--page)]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: var(--ui); color: var(--ink)\">\n<!-- Nav -->\n<header class=\"border-b border-[var(--n300)]\" data-kid=\"1-1\" data-name=\"site header bar\">\n<div class=\"mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-3 px-8\" data-kid=\"1-1-1\" data-name=\"header inner layout\">\n<span class=\"text-[18px] leading-tight\" data-kid=\"1-1-1-1\" data-name=\"site logo text\" style=\"font-family: var(--display); font-weight: 600; letter-spacing: -0.015em\">Albergues recreativos</span>\n<nav class=\"flex items-center gap-1 text-[14px] font-bold text-[var(--n700)]\" data-kid=\"1-1-1-2\" data-name=\"main navigation\">\n<span class=\"inline-flex h-11 items-center px-3\" data-kid=\"1-1-1-2-1\" data-name=\"nav link: Albergues\">Albergues</span>\n<span class=\"inline-flex h-11 items-center px-3\" data-kid=\"1-1-1-2-2\" data-name=\"nav link: Cómo funciona\">Cómo funciona</span>\n<span class=\"inline-flex h-11 items-center px-3\" data-kid=\"1-1-1-2-3\" data-name=\"nav link: Ayuda\">Ayuda</span>\n</nav>\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-1-3\" data-name=\"header actions group\">\n<span class=\"inline-flex h-11 items-center gap-1 px-3 text-[14px] font-bold text-[var(--n700)]\" data-kid=\"1-1-1-3-1\" data-name=\"nav link: Mi reserva\">Mi reserva</span>\n<span class=\"inline-flex h-11 items-center rounded-[8px] bg-[var(--accent)] px-3 text-[14px] font-bold\" data-kid=\"1-1-1-3-2\" data-name=\"Reservar call-to-action button\" style=\"color: #fcf9f2\">Reservar</span>\n</div>\n</div>\n</header>\n<div class=\"mx-auto grid max-w-[1200px] gap-6 px-8 pt-8 pb-16\" data-kid=\"1-2\" data-name=\"main content grid\">\n<!-- Encabezado -->\n<div class=\"grid gap-2\" data-kid=\"1-2-1\" data-name=\"section header container\">\n<span class=\"inline-flex items-center gap-1 text-[14px] font-bold text-[var(--accent)]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb trail link\">\n<svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-1-1-1\" data-name=\"left arrow back icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<path d=\"M19 12H5M12 19l-7-7 7-7\"></path>\n</svg>\n        Albergues\n      </span>\n<h1 class=\"max-w-[26ch] text-[32px] leading-[1.12]\" data-kid=\"1-2-1-2\" data-name=\"page headline\" style=\"font-family: var(--display); font-weight: 600; letter-spacing: -0.015em; margin: 0\">\n        Reservá en Maestro José Fierro\n      </h1>\n<div class=\"flex flex-wrap items-center gap-x-4 gap-y-2 text-[14px] text-[var(--n600)]\" data-kid=\"1-2-1-3\" data-name=\"booking details meta line\">\n<span class=\"inline-flex items-center gap-2 rounded-[8px] border border-[var(--n300)] bg-[#f6f0e5] px-3 py-1 text-[14px] font-bold text-[var(--n700)]\" data-kid=\"1-2-1-3-1\" data-name=\"bed type badge\">\n<span class=\"h-[6px] w-[6px] rounded-full bg-current\" data-kid=\"1-2-1-3-1-1\" data-name=\"badge status dot\"></span>\n          Estadía con camas\n        </span>\n<span data-kid=\"1-2-1-3-2\" data-name=\"total beds count text\">92 camas en total</span>\n<span data-kid=\"1-2-1-3-3\" data-name=\"per-bed nightly price text\">$5.000 por cama y noche</span>\n</div>\n</div>\n<!-- Barra de pasos -->\n<ol class=\"grid grid-cols-4 gap-2\" data-kid=\"1-2-2\" data-name=\"booking steps progress bar\" style=\"list-style: none; margin: 0; padding: 0\">\n<li class=\"grid content-start gap-1 border-t-2 border-t-[var(--green)] pt-3\" data-kid=\"1-2-2-1\" data-name=\"step 1 card: group\">\n<span class=\"inline-flex items-center gap-2 text-[14px] font-bold text-[var(--green)]\" data-kid=\"1-2-2-1-1\" data-name=\"step 1 completed indicator\" style=\"font-variant-numeric: tabular-nums\">\n<svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-2-1-1-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>\n          1\n        </span>\n<span class=\"text-[14px] font-bold text-[var(--n700)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2\" data-name=\"step 1 title\" data-reason=\"content reinitialized by stepper state machine to reflect active step\">Tu grupo</span>\n<span class=\"text-[14px] text-[var(--n600)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-3\" data-name=\"step 1 subtitle\" data-reason=\"content reinitialized by stepper state machine to reflect active step\">Cantidad y precio</span>\n</li>\n<li class=\"grid content-start gap-1 border-t-2 border-t-[var(--green)] pt-3\" data-kid=\"1-2-2-2\" data-name=\"step 2 card: delegación\">\n<span class=\"inline-flex items-center gap-2 text-[14px] font-bold text-[var(--green)]\" data-kid=\"1-2-2-2-1\" data-name=\"step 2 completed indicator\" style=\"font-variant-numeric: tabular-nums\">\n<svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-2-2-1-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>\n          2\n        </span>\n<span class=\"text-[14px] font-bold text-[var(--n700)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2\" data-name=\"step 2 title\" data-reason=\"content reinitialized by stepper state machine to reflect active step\">Delegación</span>\n<span class=\"text-[14px] text-[var(--n600)]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3\" data-name=\"step 2 subtitle\" data-reason=\"content reinitialized by stepper state machine to reflect active step\">Tipo de institución</span>\n</li>\n<li class=\"grid content-start gap-1 border-t-2 border-t-[var(--green)] pt-3\" data-kid=\"1-2-2-3\" data-name=\"step 3 card: fechas\">\n<span class=\"inline-flex items-center gap-2 text-[14px] font-bold text-[var(--green)]\" data-kid=\"1-2-2-3-1\" data-name=\"step 3 completed indicator\" style=\"font-variant-numeric: tabular-nums\">\n<svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-2-3-1-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>\n          3\n        </span>\n<span class=\"text-[14px] font-bold text-[var(--n700)]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2\" data-name=\"step 3 title\" data-reason=\"content reinitialized by stepper state machine to reflect active step\">Fechas</span>\n<span class=\"text-[14px] text-[var(--n600)]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-3\" data-name=\"step 3 subtitle\" data-reason=\"content reinitialized by stepper state machine to reflect active step\">Día o rango</span>\n</li>\n<li class=\"grid content-start gap-1 border-t-2 border-t-[var(--accent)] pt-3\" data-kid=\"1-2-2-4\" data-name=\"step 4 card: datos (active)\">\n<span class=\"text-[14px] font-bold\" data-dynamic=\"true\" data-kid=\"1-2-2-4-1\" data-name=\"step 4 number indicator\" data-reason=\"content reinitialized by stepper state machine to reflect active step\" style=\"font-variant-numeric: tabular-nums\">4</span>\n<span class=\"text-[14px] font-bold\" data-dynamic=\"true\" data-kid=\"1-2-2-4-2\" data-name=\"step 4 title\" data-reason=\"content reinitialized by stepper state machine to reflect active step\">Datos</span>\n<span class=\"text-[14px] text-[var(--n600)]\" data-dynamic=\"true\" data-kid=\"1-2-2-4-3\" data-name=\"step 4 subtitle\" data-reason=\"content reinitialized by stepper state machine to reflect active step\">Responsable y contacto</span>\n</li>\n</ol>\n<div class=\"grid grid-cols-[minmax(0,1fr)_336px] items-start gap-8\" data-kid=\"1-2-3\" data-name=\"form layout two columns\">\n<section class=\"grid gap-6 rounded-[12px] border border-[var(--n300)] bg-[var(--surface)] p-6\" data-kid=\"1-2-3-1\" data-name=\"reservation data form card\">\n<div class=\"grid gap-1\" data-kid=\"1-2-3-1-1\" data-name=\"form header block\">\n<h2 class=\"text-[24px] leading-snug\" data-kid=\"1-2-3-1-1-1\" data-name=\"form section title\" style=\"font-family: var(--display); font-weight: 600; letter-spacing: -0.015em; margin: 0\">Datos</h2>\n<p class=\"max-w-[54ch] text-[14px] leading-[1.55] text-[var(--n700)]\" data-kid=\"1-2-3-1-1-2\" data-name=\"form description text\" style=\"margin: 0\">\n            Con estos datos se arma la nota de la reserva. El DNI del responsable es lo que te piden para cancelar o cambiar la fecha.\n          </p>\n</div>\n<div class=\"grid grid-cols-2 gap-4\" data-kid=\"1-2-3-1-2\" data-name=\"form fields grid\">\n<div class=\"col-span-2 grid gap-2\" data-kid=\"1-2-3-1-2-1\" data-name=\"institution field group\">\n<span class=\"campo-label\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"institution field label\">Institución</span>\n<span class=\"campo-input flex items-center\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"institution text input\" style=\"color: var(--n600)\">Escuela o institución</span>\n</div>\n<div class=\"grid gap-2\" data-kid=\"1-2-3-1-2-2\" data-name=\"group leader field group\">\n<span class=\"campo-label\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"group leader field label\">Responsable del grupo</span>\n<span class=\"campo-input flex items-center\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"group leader text input\" style=\"color: var(--n600)\">Nombre y apellido</span>\n</div>\n<div class=\"grid gap-2\" data-kid=\"1-2-3-1-2-3\" data-name=\"DNI field group with error\">\n<span class=\"campo-label\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"DNI field label\">DNI del responsable</span>\n<span class=\"campo-input campo-input--error flex items-center\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"DNI text input with error state\">3011</span>\n<span class=\"campo-error\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"DNI error message container\" data-reason=\"error visibility and text driven by client validation state\">\n<svg aria-hidden=\"true\" class=\"mt-[2px] h-5 w-5\" data-kid=\"1-2-3-1-2-3-3-1\" data-name=\"error warning icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path>\n<path d=\"M12 9v4M12 17h.01\"></path>\n</svg>\n              El DNI tiene que tener 8 números.\n            </span>\n</div>\n<div class=\"grid gap-2\" data-kid=\"1-2-3-1-2-4\" data-name=\"phone field group with error\">\n<span class=\"campo-label\" data-kid=\"1-2-3-1-2-4-1\" data-name=\"phone field label\">Celular del responsable</span>\n<div class=\"grid grid-cols-[112px_minmax(0,1fr)] gap-2\" data-kid=\"1-2-3-1-2-4-2\" data-name=\"phone input split layout\">\n<span class=\"campo-input flex items-center justify-between gap-2\" data-kid=\"1-2-3-1-2-4-2-1\" data-name=\"phone area code dropdown\">\n                381\n                <svg aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--n600)]\" data-kid=\"1-2-3-1-2-4-2-1-1\" data-name=\"dropdown chevron icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\"><path d=\"m6 9 6 6 6-6\"></path></svg>\n</span>\n<span class=\"campo-input campo-input--error flex items-center\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-4-2-2\" data-name=\"phone number input with error state\" data-reason=\"value 555 set by client validation state to display error context\">555</span>\n</div>\n<span class=\"campo-error\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-4-3\" data-name=\"phone error message container\" data-reason=\"error visibility and text driven by client validation state\">\n<svg aria-hidden=\"true\" class=\"mt-[2px] h-5 w-5\" data-kid=\"1-2-3-1-2-4-3-1\" data-name=\"error warning icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path>\n<path d=\"M12 9v4M12 17h.01\"></path>\n</svg>\n              El número tiene que tener 7 dígitos.\n            </span>\n</div>\n<div class=\"grid gap-2\" data-kid=\"1-2-3-1-2-5\" data-name=\"email field group\">\n<span class=\"campo-label\" data-kid=\"1-2-3-1-2-5-1\" data-name=\"email field label\">Correo electrónico</span>\n<span class=\"campo-input flex items-center\" data-kid=\"1-2-3-1-2-5-2\" data-name=\"email text input\" style=\"color: var(--n600)\">nombre@correo.com</span>\n</div>\n<div class=\"col-span-2 grid grid-cols-[20px_minmax(0,1fr)] items-start gap-x-3 gap-y-1 py-2\" data-kid=\"1-2-3-1-2-6\" data-name=\"terms checkbox row with error\">\n<span class=\"mt-[2px] block h-5 w-5 rounded-[8px] border border-[var(--n500)] bg-[#f6f0e5]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-6-1\" data-name=\"unchecked checkbox box\" data-reason=\"checkbox checked state driven by client interaction state\"></span>\n<span class=\"text-[14px] leading-[1.55]\" data-kid=\"1-2-3-1-2-6-2\" data-name=\"terms acceptance text\">\n              Leí y acepto el\n              <span class=\"font-bold text-[var(--accent)] underline underline-offset-[3px]\" data-kid=\"1-2-3-1-2-6-2-1\" data-name=\"regulations hyperlink\">reglamento del albergue</span>\n              y las condiciones de cancelación.\n            </span>\n<span class=\"campo-error col-start-2\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-6-3\" data-name=\"terms error message container\" data-reason=\"error visibility and text driven by client validation state\">\n<svg aria-hidden=\"true\" class=\"mt-[2px] h-5 w-5\" data-kid=\"1-2-3-1-2-6-3-1\" data-name=\"error warning icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path>\n<path d=\"M12 9v4M12 17h.01\"></path>\n</svg>\n              Para reservar tenés que aceptar el reglamento.\n            </span>\n</div>\n</div>\n<div class=\"flex flex-wrap items-center gap-x-4 gap-y-3\" data-kid=\"1-2-3-1-3\" data-name=\"form actions row\">\n<span class=\"inline-flex h-14 min-w-[12rem] items-center justify-center rounded-[8px] bg-[var(--accent)] px-6 text-[16px] font-bold\" data-kid=\"1-2-3-1-3-1\" data-name=\"confirm reservation primary button\" style=\"color: #fcf9f2\">\n            Confirmar reserva\n          </span>\n<span class=\"inline-flex items-center gap-1 text-[14p