      "html": "<style>\n  @import url(\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;700&family=Source+Serif+4:opsz,wght@8..60,600&display=swap\");\n\n  :root {\n    --page: #fcf9f2;\n    --surface: #ffffff;\n    --sunken: #f6f0e5;\n    --n200: #e9e1d3;\n    --n300: #d6cbb8;\n    --n500: #8e8474;\n    --n600: #6b6355;\n    --n700: #4c463d;\n    --ink: #2c2622;\n    --accent: #a84c27;\n    --accent-soft: #f7e7dc;\n    --green: #2b5b3e;\n    --danger: #8f3a2b;\n    --ui: \"Manrope\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n    --display: \"Source Serif 4\", Georgia, serif;\n  }\n\n  .campo-label {\n    font-family: var(--ui);\n    font-size: 14px;\n    font-weight: 700;\n    line-height: 1.32;\n    color: var(--ink);\n  }\n\n  .campo-input {\n    width: 100%;\n    height: 48px;\n    padding: 8px 12px;\n    background: var(--surface);\n    border: 1px solid var(--n500);\n    border-radius: 8px;\n    color: var(--ink);\n    font-family: var(--ui);\n    font-size: 16px;\n  }\n\n  .campo-input::placeholder {\n    color: var(--n600);\n  }\n\n  .campo-ayuda {\n    font-size: 14px;\n    line-height: 1.32;\n    color: var(--n600);\n  }\n</style>\n<div class=\"min-h-screen bg-[var(--page)]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: var(--ui); color: var(--ink)\">\n<!-- Nav -->\n<header class=\"border-b border-[var(--n300)]\" data-kid=\"1-1\" data-name=\"site header with bottom border\">\n<div class=\"mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-3 px-8\" data-kid=\"1-1-1\" data-name=\"header layout bar\">\n<span class=\"text-[18px] leading-tight\" data-kid=\"1-1-1-1\" data-name=\"site brand name\" style=\"font-family: var(--display); font-weight: 600; letter-spacing: -0.015em\">Albergues recreativos</span>\n<nav class=\"flex items-center gap-1 text-[14px] font-bold text-[var(--n700)]\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n<span class=\"inline-flex h-11 items-center px-3\" data-kid=\"1-1-1-2-1\" data-name=\"nav link: Albergues\">Albergues</span>\n<span class=\"inline-flex h-11 items-center px-3\" data-kid=\"1-1-1-2-2\" data-name=\"nav link: Cómo funciona\">Cómo funciona</span>\n<span class=\"inline-flex h-11 items-center px-3\" data-kid=\"1-1-1-2-3\" data-name=\"nav link: Ayuda\">Ayuda</span>\n</nav>\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-1-3\" data-name=\"header actions group\">\n<span class=\"inline-flex h-11 items-center gap-1 px-3 text-[14px] font-bold text-[var(--n700)]\" data-kid=\"1-1-1-3-1\" data-name=\"my reservation link\">Mi reserva</span>\n<span class=\"inline-flex h-11 items-center rounded-[8px] bg-[var(--accent)] px-3 text-[14px] font-bold\" data-kid=\"1-1-1-3-2\" data-name=\"primary reserve button\" style=\"color: #fcf9f2\">Reservar</span>\n</div>\n</div>\n</header>\n<div class=\"mx-auto grid max-w-[1200px] gap-6 px-8 pt-8 pb-16\" data-kid=\"1-2\" data-name=\"main content grid\">\n<!-- Encabezado del wizard -->\n<div class=\"grid gap-2\" data-kid=\"1-2-1\" data-name=\"wizard page heading block\">\n<span class=\"inline-flex items-center gap-1 text-[14px] font-bold text-[var(--accent)]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb label with back icon\">\n<svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-1-1-1\" data-name=\"left arrow back icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<path d=\"M19 12H5M12 19l-7-7 7-7\"></path>\n</svg>\n        Albergues\n      </span>\n<h1 class=\"max-w-[26ch] text-[32px] leading-[1.12]\" data-kid=\"1-2-1-2\" data-name=\"page headline\" style=\"font-family: var(--display); font-weight: 600; letter-spacing: -0.015em; margin: 0\">\n        Reservá en Maestro José Fierro\n      </h1>\n<div class=\"flex flex-wrap items-center gap-x-4 gap-y-2 text-[14px] text-[var(--n600)]\" data-kid=\"1-2-1-3\" data-name=\"accommodation key facts row\">\n<span class=\"inline-flex items-center gap-2 rounded-[8px] border border-[var(--n300)] bg-[var(--sunken)] px-3 py-1 text-[14px] font-bold text-[var(--n700)]\" data-kid=\"1-2-1-3-1\" data-name=\"accommodation mode badge with dot\">\n<span class=\"h-[6px] w-[6px] rounded-full bg-current\" data-kid=\"1-2-1-3-1-1\" data-name=\"badge status dot\"></span>\n          Estadía con camas\n        </span>\n<span data-kid=\"1-2-1-3-2\" data-name=\"total beds count text\">92 camas en total</span>\n<span data-kid=\"1-2-1-3-3\" data-name=\"price per bed and night text\">$5.000 por cama y noche</span>\n</div>\n</div>\n<!-- Barra de pasos -->\n<ol class=\"grid grid-cols-4 gap-2\" data-kid=\"1-2-2\" data-name=\"wizard step progress bar\" style=\"list-style: none; margin: 0; padding: 0\">\n<li class=\"grid content-start gap-1 border-t-2 border-t-[var(--green)] pt-3\" data-kid=\"1-2-2-1\" data-name=\"completed step: Tu grupo\">\n<span class=\"inline-flex items-center gap-2 text-[14px] font-bold text-[var(--green)]\" data-kid=\"1-2-2-1-1\" data-name=\"completed step number with checkmark\" style=\"font-variant-numeric: tabular-nums\">\n<svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-2-1-1-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>\n          1\n        </span>\n<span class=\"text-[14px] font-bold text-[var(--n700)]\" data-kid=\"1-2-2-1-2\" data-name=\"step title: Tu grupo\">Tu grupo</span>\n<span class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-2-1-3\" data-name=\"step description\">Cantidad y precio</span>\n</li>\n<li class=\"grid content-start gap-1 border-t-2 border-t-[var(--green)] pt-3\" data-kid=\"1-2-2-2\" data-name=\"completed step: Delegación\">\n<span class=\"inline-flex items-center gap-2 text-[14px] font-bold text-[var(--green)]\" data-kid=\"1-2-2-2-1\" data-name=\"completed step number with checkmark\" style=\"font-variant-numeric: tabular-nums\">\n<svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-2-2-1-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>\n          2\n        </span>\n<span class=\"text-[14px] font-bold text-[var(--n700)]\" data-kid=\"1-2-2-2-2\" data-name=\"step title: Delegación\">Delegación</span>\n<span class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-2-2-3\" data-name=\"step description\">Tipo de institución</span>\n</li>\n<li class=\"grid content-start gap-1 border-t-2 border-t-[var(--green)] pt-3\" data-kid=\"1-2-2-3\" data-name=\"completed step: Fechas\">\n<span class=\"inline-flex items-center gap-2 text-[14px] font-bold text-[var(--green)]\" data-kid=\"1-2-2-3-1\" data-name=\"completed step number with checkmark\" style=\"font-variant-numeric: tabular-nums\">\n<svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-2-3-1-1\" data-name=\"checkmark icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg>\n          3\n        </span>\n<span class=\"text-[14px] font-bold text-[var(--n700)]\" data-kid=\"1-2-2-3-2\" data-name=\"step title: Fechas\">Fechas</span>\n<span class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-2-3-3\" data-name=\"step description\">Día o rango</span>\n</li>\n<li class=\"grid content-start gap-1 border-t-2 border-t-[var(--accent)] pt-3\" data-kid=\"1-2-2-4\" data-name=\"current step: Datos\">\n<span class=\"text-[14px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-4-1\" data-name=\"current step number\" style=\"font-variant-numeric: tabular-nums\">4</span>\n<span class=\"text-[14px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-4-2\" data-name=\"current step title: Datos\">Datos</span>\n<span class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-2-4-3\" data-name=\"current step description\">Responsable y contacto</span>\n</li>\n</ol>\n<div class=\"grid grid-cols-[minmax(0,1fr)_336px] items-start gap-8\" data-kid=\"1-2-3\" data-name=\"form and summary two-column layout\">\n<!-- Panel del paso -->\n<section class=\"grid gap-6 rounded-[12px] border border-[var(--n300)] bg-[var(--surface)] p-6\" data-kid=\"1-2-3-1\" data-name=\"reservation data form panel\">\n<div class=\"grid gap-1\" data-kid=\"1-2-3-1-1\" data-name=\"form panel heading block\">\n<h2 class=\"text-[24px] leading-snug\" data-kid=\"1-2-3-1-1-1\" data-name=\"form panel title\" style=\"font-family: var(--display); font-weight: 600; letter-spacing: -0.015em; margin: 0\">Datos</h2>\n<p class=\"max-w-[54ch] text-[14px] leading-[1.55] text-[var(--n700)]\" data-kid=\"1-2-3-1-1-2\" data-name=\"form panel helper text\" style=\"margin: 0\">\n            Con estos datos se arma la nota de la reserva. El DNI del responsable es lo que te piden para cancelar o cambiar la fecha.\n          </p>\n</div>\n<div class=\"grid grid-cols-2 gap-4\" data-kid=\"1-2-3-1-2\" data-name=\"form fields grid\">\n<div class=\"col-span-2 grid gap-2\" data-kid=\"1-2-3-1-2-1\" data-name=\"institution field group\">\n<span class=\"campo-label\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"institution field label\">Institución</span>\n<span class=\"campo-input flex items-center\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"institution input placeholder\" style=\"color: var(--n600)\">Escuela o institución</span>\n</div>\n<div class=\"grid gap-2\" data-kid=\"1-2-3-1-2-2\" data-name=\"group responsible field group\">\n<span class=\"campo-label\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"group responsible field label\">Responsable del grupo</span>\n<span class=\"campo-input flex items-center\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"group responsible input placeholder\" style=\"color: var(--n600)\">Nombre y apellido</span>\n</div>\n<div class=\"grid gap-2\" data-kid=\"1-2-3-1-2-3\" data-name=\"DNI field group\">\n<span class=\"campo-label\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"DNI field label\">DNI del responsable</span>\n<span class=\"campo-input flex items-center\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"DNI input placeholder\" style=\"color: var(--n600)\">8 números</span>\n<span class=\"campo-ayuda\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"DNI field help text\">Sin puntos ni espacios.</span>\n</div>\n<div class=\"grid gap-2\" data-kid=\"1-2-3-1-2-4\" data-name=\"cell phone field group\">\n<span class=\"campo-label\" data-kid=\"1-2-3-1-2-4-1\" data-name=\"cell phone field label\">Celular del responsable</span>\n<div class=\"grid grid-cols-[112px_minmax(0,1fr)] gap-2\" data-kid=\"1-2-3-1-2-4-2\" data-name=\"cell phone input row\">\n<span class=\"campo-input flex items-center justify-between gap-2\" data-kid=\"1-2-3-1-2-4-2-1\" data-name=\"area code dropdown with chevron\">\n                381\n                <svg aria-hidden=\"true\" class=\"h-4 w-4 text-[var(--n600)]\" data-kid=\"1-2-3-1-2-4-2-1-1\" data-name=\"down chevron icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\"><path d=\"m6 9 6 6 6-6\"></path></svg>\n</span>\n<span class=\"campo-input flex items-center\" data-kid=\"1-2-3-1-2-4-2-2\" data-name=\"phone number input placeholder\" style=\"color: var(--n600)\">555 1234</span>\n</div>\n<span class=\"campo-ayuda\" data-kid=\"1-2-3-1-2-4-3\" data-name=\"cell phone field help text\">Sin 0 ni 15.</span>\n</div>\n<div class=\"grid gap-2\" data-kid=\"1-2-3-1-2-5\" data-name=\"email field group\">\n<span class=\"campo-label\" data-kid=\"1-2-3-1-2-5-1\" data-name=\"email field label\">Correo electrónico</span>\n<span class=\"campo-input flex items-center\" data-kid=\"1-2-3-1-2-5-2\" data-name=\"email input placeholder\" style=\"color: var(--n600)\">nombre@correo.com</span>\n</div>\n<div class=\"col-span-2 grid grid-cols-[20px_minmax(0,1fr)] items-start gap-x-3 gap-y-0 py-2\" data-kid=\"1-2-3-1-2-6\" data-name=\"terms checkbox row\">\n<span class=\"mt-[2px] block h-5 w-5 rounded-[8px] border border-[var(--n500)] bg-[#f6f0e5]\" data-kid=\"1-2-3-1-2-6-1\" data-name=\"terms checkbox box\"></span>\n<span class=\"text-[14px] leading-[1.55]\" data-kid=\"1-2-3-1-2-6-2\" data-name=\"terms acceptance text\">\n              Leí y acepto el\n              <span class=\"font-bold text-[var(--accent)] underline underline-offset-[3px]\" data-kid=\"1-2-3-1-2-6-2-1\" data-name=\"regulations link text\">reglamento del albergue</span>\n              y las condiciones de cancelación.\n            </span>\n</div>\n</div>\n<div class=\"flex flex-wrap items-center gap-x-4 gap-y-3\" data-kid=\"1-2-3-1-3\" data-name=\"form action buttons row\">\n<span class=\"inline-flex h-14 min-w-[12rem] items-center justify-center rounded-[8px] bg-[var(--accent)] px-6 text-[16px] font-bold\" data-kid=\"1-2-3-1-3-1\" data-name=\"confirm reservation submit button\" style=\"color: #fcf9f2\">\n            Confirmar reserva\n          </span>\n<span class=\"inline-flex items-center gap-1 text-[14px] font-bold text-[var(--accent)]\" data-kid=\"1-2-3-1-3-2\" data-name=\"return to dates back link\">\n<svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-3-1-3-2-1\" data-name=\"left arrow back icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<path d=\"M19 12H5M12 19l-7-7 7-7\"></path>\n</svg>\n            Volver a fechas\n          </span>\n</div>\n</section>\n<!-- Resumen -->\n<aside class=\"grid content-start gap-3 rounded-[12px] border border-[var(--n300)] bg-[var(--surface)] p-4\" data-kid=\"1-2-3-2\" data-name=\"reservation summary sidebar\">\n<h2 class=\"text-[14px] font-bold text-[var(--n600)]\" data-kid=\"1-2-3-2-1\" data-name=\"summary section title\" style=\"margin: 0\">Resumen</h2>\n<dl class=\"grid\" data-kid=\"1-2-3-2-2\" data-name=\"summary details list\" style=\"margin: 0\">\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[var(--n300)] py-2\" data-kid=\"1-2-3-2-2-1\" data-name=\"summary row: Albergue\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"summary label: Albergue\">Albergue</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"summary value: shelter name\" style=\"margin: 0\">Maestro José Fierro</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[var(--n300)] py-2\" data-kid=\"1-2-3-2-2-2\" data-name=\"summary row: Modalidad\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"summary label: Modalidad\">Modalidad</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"summary value: stay mode\" style=\"margin: 0\">Estadía con camas</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[var(--n300)] py-2\" data-kid=\"1-2-3-2-2-3\" data-name=\"summary row: Delegación\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"summary label: Delegación\">Delegación</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-3-2-2-3-2\" data-name=\"summary value: delegation type\" style=\"margin: 0\">Escuela</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[var(--n300)] py-2\" data-kid=\"1-2-3-2-2-4\" data-name=\"summary row: Camas\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-3-2-2-4-1\" data-name=\"summary label: Camas\">Camas</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-3-2-2-4-2\" data-name=\"summary value: bed count\" style=\"margin: 0\">3</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[var(--n300)] py-2\" data-kid=\"1-2-3-2-2-5\" data-name=\"summary row: Unitario\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-3-2-2-5-1\" data-name=\"summary label: Unitario\">Unitario</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-3-2-2-5-2\" data-name=\"summary value: unit price\" style=\"margin: 0; font-variant-numeric: tabular-nums\">$5.000</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 py-2\" data-kid=\"1-2-3-2-2-6\" data-name=\"summary row: Fechas\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-3-2-2-6-1\" data-name=\"summary label: Fechas\">Fechas</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-3-2-2-6-2\" data-name=\"summary value: date range\" style=\"margin: 0; font-variant-numeric: tabular-nums\">15/11 al 18/11</dd>\n</div>\n</dl>\n<div class=\"flex items-baseline justify-between gap-4 border-t border-[var(--n500)] pt-3\" data-kid=\"1-2-3-2-3\" data-name=\"summary total row\">\n<span class=\"text-[14px] font-bold\" data-kid=\"1-2-3-2-3-1\" data-name=\"summary total label\">Total</span>\n<span class=\"text-[24px] leading-tight\" data-kid=\"1-2-3-2-3-2\" data-name=\"summary total amount\" style=\"font-family: var(--display); font-weight: 600; letter-spacing: -0.015em; font-variant-numeric: tabular-nums\">$45.000</span>\n</div>\n<p class=\"text-[14px] leading-[1.55] text-[var(--n600)]\" data-kid=\"1-2-3-2-4\" data-name=\"summary payment note text\" style=\"margin: 0\">\n          Se paga por transferencia. Tenés 48 h para subir el comprobante; si la fecha está cerca, el plazo baja a 6 h.\n        </p>\n</aside>\n</div>\n</div>\n</div>\n",
      "comments": [],
      "created": "2026-10-31T00:23:54.884585+00:00",
      "modified": "2026-10-31T00:26:56.805208+00:00",
      "id": "var_9914028daa25",
      "contentHeight": 1000
    },
    "var_892241a33723": {
      "type": "variant",
      "label": "Confirmación · pre-reserva",
      "parentId": "var_paso4_errores",
      "themeId": null,
      "rect": {
        "x": 5520,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n  @import url(\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;700&family=Source+Serif+4:opsz,wght@8..60,600&display=swap\");\n\n  :root {\n    --page: #fcf9f2;\n    --surface: #ffffff;\n    --sunken: #f6f0e5;\n    --n200: #e9e1d3;\n    --n300: #d6cbb8;\n    --n500: #8e8474;\n    --n600: #6b6355;\n    --n700: #4c463d;\n    --ink: #2c2622;\n    --accent: #a84c27;\n    --accent-soft: #f7e7dc;\n    --green-soft: #e1eadf;\n    --green: #2b5b3e;\n    --warning-soft: #f6e9d2;\n    --warning: #7e5219;\n    --ui: \"Manrope\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n    --display: \"Source Serif 4\", Georgia, serif;\n  }\n</style>\n<div class=\"min-h-screen bg-[var(--page)]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: var(--ui); color: var(--ink)\">\n<!-- Nav -->\n<header class=\"border-b border-[var(--n300)]\" data-kid=\"1-1\" data-name=\"site header\">\n<div class=\"mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-3 px-8\" data-kid=\"1-1-1\" data-name=\"header inner bar\">\n<span class=\"text-[18px] leading-tight\" data-kid=\"1-1-1-1\" data-name=\"site brand name\" style=\"font-family: var(--display); font-weight: 600; letter-spacing: -0.015em\">Albergues recreativos</span>\n<nav class=\"flex items-center gap-1 text-[14px] font-bold text-[var(--n700)]\" data-kid=\"1-1-1-2\" data-name=\"main navigation\">\n<span class=\"inline-flex h-11 items-center px-3\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link: Albergues\">Albergues</span>\n<span class=\"inline-flex h-11 items-center px-3\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link: Cómo funciona\">Cómo funciona</span>\n<span class=\"inline-flex h-11 items-center px-3\" data-kid=\"1-1-1-2-3\" data-name=\"navigation link: Ayuda\">Ayuda</span>\n</nav>\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-1-3\" data-name=\"header secondary actions\">\n<span class=\"inline-flex h-11 items-center gap-1 px-3 text-[14px] font-bold text-[var(--n700)]\" data-kid=\"1-1-1-3-1\" data-name=\"my reservation navigation link\">Mi reserva</span>\n<span class=\"inline-flex h-11 items-center rounded-[8px] bg-[var(--accent)] px-3 text-[14px] font-bold\" data-kid=\"1-1-1-3-2\" data-name=\"book now call-to-action button\" style=\"color: #fcf9f2\">Reservar</span>\n</div>\n</div>\n<!-- Reserva en curso -->\n<div class=\"border-t border-[var(--n300)] bg-[var(--sunken)]\" data-kid=\"1-1-2\" data-name=\"in-progress reservation status bar\">\n<div class=\"mx-auto flex max-w-[1200px] flex-wrap items-center gap-x-3 gap-y-1 px-8 py-2\" data-kid=\"1-1-2-1\" data-name=\"reservation status bar inner\">\n<span class=\"text-[14px] font-bold\" data-kid=\"1-1-2-1-1\" data-name=\"reservation code display\" style=\"font-variant-numeric: tabular-nums\">R-248715</span>\n<span class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-1-2-1-2\" data-name=\"reservation lodge name\">Maestro José Fierro</span>\n<span class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-1-2-1-3\" data-name=\"reservation dates display\" style=\"font-variant-numeric: tabular-nums\">15/11 al 18/11</span>\n<span class=\"ml-auto inline-flex h-11 items-center rounded-[8px] bg-[var(--accent)] px-3 text-[14px] font-bold\" data-kid=\"1-1-2-1-4\" data-name=\"upload receipt call-to-action button\" style=\"color: #fcf9f2\">Cargar comprobante</span>\n</div>\n</div>\n</header>\n<div class=\"mx-auto grid max-w-[1200px] grid-cols-[minmax(0,1fr)_336px] items-start gap-8 px-8 pt-8 pb-16\" data-kid=\"1-2\" data-name=\"main content grid layout\">\n<!-- Estado -->\n<section class=\"grid gap-6 rounded-[12px] border border-[var(--n300)] border-t-2 border-t-[var(--green)] bg-[var(--surface)] p-6\" data-kid=\"1-2-1\" data-name=\"reservation status section\">\n<div class=\"grid gap-2\" data-kid=\"1-2-1-1\" data-name=\"status header block\">\n<span class=\"grid h-12 w-12 place-items-center justify-self-start rounded-[8px] bg-[var(--green-soft)] text-[var(--green)]\" data-kid=\"1-2-1-1-1\" data-name=\"success icon container\">\n<svg aria-hidden=\"true\" class=\"h-8 w-8\" data-kid=\"1-2-1-1-1-1\" data-name=\"checkmark in circle icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n<path d=\"m9 12 2 2 4-4\"></path>\n</svg>\n</span>\n<h1 class=\"max-w-[24ch] text-[32px] leading-[1.12]\" data-kid=\"1-2-1-1-2\" data-name=\"status headline text\" style=\"font-family: var(--display); font-weight: 600; letter-spacing: -0.015em; margin: 0\">\n          Pre-reserva creada\n        </h1>\n<p class=\"max-w-[52ch] text-[14px] leading-[1.55] text-[var(--n700)]\" data-kid=\"1-2-1-1-3\" data-name=\"status description text\" style=\"margin: 0\">\n          Guardamos las 3 camas del 15 al 18 de noviembre en Maestro José Fierro. Se confirman cuando llegue el comprobante de pago.\n        </p>\n<span class=\"inline-flex items-center gap-2 justify-self-start rounded-[8px] bg-[var(--warning-soft)] px-3 py-1 text-[14px] font-bold text-[var(--warning)]\" data-kid=\"1-2-1-1-4\" data-name=\"waiting-for-receipt badge\">\n<span class=\"h-[6px] w-[6px] rounded-full bg-current\" data-kid=\"1-2-1-1-4-1\" data-name=\"badge status dot\"></span>\n          Esperando comprobante\n        </span>\n</div>\n<div class=\"grid gap-1 rounded-[8px] border border-dashed border-[var(--n500)] bg-[var(--sunken)] p-4\" data-kid=\"1-2-1-2\" data-name=\"reservation code box\">\n<p class=\"text-[14px] font-bold uppercase leading-snug tracking-[0.08em] text-[var(--n600)]\" data-kid=\"1-2-1-2-1\" data-name=\"reservation code label\" style=\"margin: 0\">Código de reserva</p>\n<p class=\"text-[32px] leading-[1.12]\" data-kid=\"1-2-1-2-2\" data-name=\"reservation code value\" style=\"margin: 0; font-weight: 700; letter-spacing: 0.04em; font-variant-numeric: tabular-nums\">R-248715</p>\n<p class=\"text-[14px] leading-[1.55] text-[var(--n600)]\" data-kid=\"1-2-1-2-3\" data-name=\"reservation code helper text\" style=\"margin: 0\">\n          Con este código cargás el comprobante o cancelás la reserva. No hace falta usuario ni contraseña.\n        </p>\n</div>\n<div class=\"grid grid-cols-[20px_minmax(0,1fr)] items-start gap-3 rounded-[8px] bg-[var(--warning-soft)] p-3 text-[14px]\" data-kid=\"1-2-1-3\" data-name=\"deadline warning banner\">\n<svg aria-hidden=\"true\" class=\"mt-[2px] h-5 w-5 text-[var(--warning)]\" data-kid=\"1-2-1-3-1\" data-name=\"warning triangle icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path>\n<path d=\"M12 9v4M12 17h.01\"></path>\n</svg>\n<div class=\"grid gap-1\" data-kid=\"1-2-1-3-2\" data-name=\"warning text block\">\n<p class=\"font-bold leading-snug\" data-kid=\"1-2-1-3-2-1\" data-name=\"warning headline text\" style=\"margin: 0\">Subí el comprobante antes del 1/11 a las 18:00</p>\n<p class=\"leading-[1.55] text-[var(--n700)]\" data-kid=\"1-2-1-3-2-2\" data-name=\"warning detail text\" style=\"margin: 0\">\n            Pasado ese plazo la pre-reserva se libera y las camas vuelven a estar disponibles. Si el ingreso es en menos de 48 h, el plazo baja a 6 h.\n          </p>\n</div>\n</div>\n<div class=\"flex flex-wrap items-center gap-x-4 gap-y-3\" data-kid=\"1-2-1-4\" data-name=\"status action bar\">\n<span class=\"inline-flex h-14 min-w-[14rem] items-center justify-center gap-2 rounded-[8px] bg-[var(--accent)] px-6 text-[16px] font-bold\" data-kid=\"1-2-1-4-1\" data-name=\"primary upload receipt button\" style=\"color: #fcf9f2\">\n<svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-1-4-1-1\" data-name=\"upload arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n<path d=\"M17 8l-5-5-5 5\"></path>\n<path d=\"M12 3v12\"></path>\n</svg>\n          Cargar comprobante\n        </span>\n<span class=\"inline-flex h-12 items-center justify-center rounded-[8px] border border-[var(--n500)] px-4 text-[16px] font-bold\" data-kid=\"1-2-1-4-2\" data-name=\"my reservation secondary button\">Mi reserva</span>\n<span class=\"text-[14px] font-bold text-[var(--accent)] underline underline-offset-[3px]\" data-kid=\"1-2-1-4-3\" data-name=\"return to shelters link\">Volver a los albergues</span>\n</div>\n</section>\n<!-- Detalle -->\n<aside class=\"grid gap-4\" data-kid=\"1-2-2\" data-name=\"sidebar details container\">\n<div class=\"grid content-start gap-3 rounded-[12px] border border-[var(--n300)] bg-[var(--surface)] p-4\" data-kid=\"1-2-2-1\" data-name=\"reservation details card\">\n<h2 class=\"text-[14px] font-bold text-[var(--n600)]\" data-kid=\"1-2-2-1-1\" data-name=\"reservation details card title\" style=\"margin: 0\">Tu reserva</h2>\n<dl class=\"grid\" data-kid=\"1-2-2-1-2\" data-name=\"reservation details list\" style=\"margin: 0\">\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[var(--n300)] py-2\" data-kid=\"1-2-2-1-2-1\" data-name=\"lodge detail row\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"lodge detail label\">Albergue</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"lodge detail value\" style=\"margin: 0\">Maestro José Fierro</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[var(--n300)] py-2\" data-kid=\"1-2-2-1-2-2\" data-name=\"modality detail row\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"modality detail label\">Modalidad</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"modality detail value\" style=\"margin: 0\">Estadía con camas</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[var(--n300)] py-2\" data-kid=\"1-2-2-1-2-3\" data-name=\"delegation detail row\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"delegation detail label\">Delegación</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"delegation detail value\" style=\"margin: 0\">Escuela</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[var(--n300)] py-2\" data-kid=\"1-2-2-1-2-4\" data-name=\"beds detail row\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"beds detail label\">Camas</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-2-1-2-4-2\" data-name=\"beds count value\" style=\"margin: 0\">3</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[var(--n300)] py-2\" data-kid=\"1-2-2-1-2-5\" data-name=\"dates detail row\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-2-1-2-5-1\" data-name=\"dates detail label\">Fechas</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-2-1-2-5-2\" data-name=\"dates detail value\" style=\"margin: 0; font-variant-numeric: tabular-nums\">15/11 al 18/11</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-b border-[var(--n300)] py-2\" data-kid=\"1-2-2-1-2-6\" data-name=\"check-in detail row\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-2-1-2-6-1\" data-name=\"check-in label\">Ingreso</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-2-1-2-6-2\" data-name=\"check-in value\" style=\"margin: 0; font-variant-numeric: tabular-nums\">15/11, 09:00</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 py-2\" data-kid=\"1-2-2-1-2-7\" data-name=\"check-out detail row\">\n<dt class=\"text-[14px] text-[var(--n600)]\" data-kid=\"1-2-2-1-2-7-1\" data-name=\"check-out label\">Salida</dt>\n<dd class=\"text-right text-[14px] font-bold\" data-kid=\"1-2-2-1-2-7-2\" data-name=\"check-out value\" style=\"margin: 0; font-variant-numeric: tabular-nums\">18/11, 18:00</dd>\n</div>\n</dl>\n<div class=\"flex items-baseline justify-between gap-4 border-t border-[var(--n500)] pt-3\" data-kid=\"1-2-2-1-3\" data-name=\"total price footer\">\n<span class=\"text-[14px] font-bold\" data-kid=\"1-2-2-1-3-1\" data-name=\"total label\">Total</span>\n<span class=\"text-[24px] leading-tight\" data-kid=\"1-2-2-1-3-2\" data-name=\"total price value\" style=\"font-family: var(--display); font-weight: 600; letter-spacing: -0.015em; font-variant-numeric: tabular-nums\">$45.000</span>\n</div>\n</div>\n<div class=\"grid content-start gap-3 rounded-[12px] border border-[var(--n300)] bg-[var(--surface)] p-4\" data-kid=\"1-2-2-2\" data-name=\"what-happens-next card\">\n<h2 class=\"text-[14px] font-bold text-[var(--n600)]\" data-kid=\"1-2-2-2-1\" data-name=\"what-happens-next card title\" style=\"margin: 0\">Qué sigue</h2>\n<ol class=\"grid\" data-kid=\"1-2-2-2-2\" data-name=\"next steps ordered list\" style=\"margin: 0; padding: 0; list-style: none\">\n<li class=\"grid grid-cols-[24px_minmax(0,1fr)] gap-x-2 border-b border-[var(--n300)] py-3\" data-kid=\"1-2-2-2-2-1\" data-name=\"next step item: upload receipt\">\n<span class=\"text-[16px] leading-[1.2] text-[var(--accent)]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"step number 1\" style=\"font-family: var(--display); font-weight: 600\">1</span>\n<div data-kid=\"1-2-2-2-2-1-2\" data-name=\"step 1 content\">\n<p class=\"text-[14px] font-bold leading-snug\" data-kid=\"1-2-2-2-2-1-2-1\" data-name=\"step 1 title\" style=\"margin: 0\">Subí el comprobante</p>\n<p class=\"mt-1 text-[14px] leading-[1.55] text-[var(--n600)]\" data-kid=\"1-2-2-2-2-1-2-2\" data-name=\"step 1 description\" style=\"margin: 0\">Desde la página de pago, con el código R-248715.</p>\n</div>\n</li>\n<li class=\"grid grid-cols-[24px_minmax(0,1fr)] gap-x-2 border-b border-[var(--n300)] py-3\" data-kid=\"1-2-2-2-2-2\" data-name=\"next step item: confirmation\">\n<span class=\"text-[16px] leading-[1.2] text-[var(--accent)]\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"step number 2\" style=\"font-family: var(--display); font-weight: 600\">2</span>\n<div data-kid=\"1-2-2-2-2-2-2\" data-name=\"step 2 content\">\n<p class=\"text-[14px] font-bold leading-snug\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"step 2 title\" style=\"margin: 0\">Confirmamos la reserva</p>\n<p class=\"mt-1 text-[14px] leading-[1.55] text-[var(--n600)]\" data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"step 2 description\" style=\"margin: 0\">Cuando el pago se acredita, la pre-reserva pasa a confirmada.</p>\n</div>\n</li>\n<li class=\"grid grid-cols-[24px_minmax(0,1fr)] gap-x-2 py-3\" data-kid=\"1-2-2-2-2-3\" data-name=\"next step item: check-in day\">\n<span class=\"text-[16px] leading-[1.2] text-[var(--accent)]\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"step number 3\" style=\"font-family: var(--display); font-weight: 600\">3</span>\n<div data-kid=\"1-2-2-2-2-3-2\" data-name=\"step 3 content\">\n<p class=\"text-[14px] font-bold leading-snug\" data-kid=\"1-2-2-2-2-3-2-1\" data-name=\"step 3 title\" style=\"margin: 0\">El día del ingreso</p>\n<p class=\"mt-1 text-[14px] leading-[1.55] text-[var(--n600)]\" data-kid=\"1-2-2-2-2-3-2-2\" data-name=\"step 3 description\" style=\"margin: 0\">Presentate el 15/11 a las 09:00 con el código a mano.</p>\n<span class=\"mt-2 inline-flex items-center gap-1 text-[14px] font-bold text-[var(--accent)]\" data-kid=\"1-2-2-2-2-3-2-3\" data-name=\"view map link\">\n<svg aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-2-2-2-3-2-3-1\" data-name=\"location pin icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"></path>\n<circle cx=\"12\" cy=\"10\" r=\"3\"></circle>\n</svg>\n                Ver mapa\n              </span>\n</div>\n</li>\n</ol>\n</div>\n</aside>\n</div>\n</div>\n",
