      "html": "<style>\n  @import url(\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;700&family=Source+Serif+4:opsz,wght@8..60,600&display=swap\");\n\n  :root {\n    --page: #fcf9f2;\n    --surface: #ffffff;\n    --sunken: #f6f0e5;\n    --n200: #e9e1d3;\n    --n300: #d6cbb8;\n    --n500: #8e8474;\n    --n600: #6b6355;\n    --n700: #4c463d;\n    --ink: #2c2622;\n    --accent: #a84c27;\n    --accent-soft: #f7e7dc;\n    --green-soft: #e1eadf;\n    --green: #2b5b3e;\n    --warning-soft: #f6e9d2;\n    --warning: #7e5219;\n    --ui: \"Manrope\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n    --display: \"Source Serif 4\", Georgia, serif;\n  }\n</style>\n<div class=\"flex min-h-screen items-center bg-[var(--page)] px-10 py-16\" data-kid=\"1\" data-name=\"centered reservation wizard page container\" style=\"font-family: var(--ui); color: var(--ink)\">\n<div class=\"mx-auto w-full max-w-[1160px] overflow-hidden rounded-[12px] border border-[var(--n300)] bg-[var(--surface)]\" data-kid=\"1-1\" data-name=\"reservation wizard card panel\">\n<div class=\"grid grid-cols-[1.1fr_1fr_1fr_1fr_1.3fr]\" data-kid=\"1-1-1\" data-name=\"stepper grid layout\">\n<!-- 1 · Tu grupo -->\n<div class=\"flex flex-col border-r border-[var(--n300)] p-5\" data-kid=\"1-1-1-1\" data-name=\"booking step 1 group card\">\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-1-1\" data-name=\"step header label row\">\n<span class=\"text-[20px] leading-none text-[var(--accent)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"step number badge\" style=\"font-family: var(--display); font-weight: 600; font-variant-numeric: tabular-nums\">1</span>\n<span class=\"text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-1-1-2\" data-name=\"step title text\">Tu grupo</span>\n</div>\n<p class=\"mt-4 text-[14px] leading-snug text-[var(--n600)]\" data-kid=\"1-1-1-1-2\" data-name=\"step detail beds count\">3 camas</p>\n<p class=\"mt-1 text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-1-3\" data-name=\"step detail price per bed and night\" style=\"font-variant-numeric: tabular-nums\">$5.000 por cama y noche</p>\n<span class=\"mt-auto inline-flex items-center justify-center rounded-[8px] border border-[var(--n500)] px-3 py-2 text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-1-4\" data-name=\"step continue to next action label\">Continuar a delegación</span>\n</div>\n<!-- 2 · Delegación -->\n<div class=\"flex flex-col border-r border-[var(--n300)] p-5\" data-kid=\"1-1-1-2\" data-name=\"booking step 2 delegation card\">\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-2-1\" data-name=\"step header label row\">\n<span class=\"text-[20px] leading-none text-[var(--accent)]\" data-kid=\"1-1-1-2-1-1\" data-name=\"step number badge\" style=\"font-family: var(--display); font-weight: 600; font-variant-numeric: tabular-nums\">2</span>\n<span class=\"text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-2-1-2\" data-name=\"step title text\">Delegación</span>\n</div>\n<p class=\"mt-4 text-[14px] leading-snug text-[var(--n600)]\" data-kid=\"1-1-1-2-2\" data-name=\"step detail institution type\">Escuela o grupo educativo</p>\n<p class=\"mt-1 text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-2-3\" data-name=\"step detail max nights\">Hasta 4 noches</p>\n<span class=\"mt-auto inline-flex items-center justify-center rounded-[8px] border border-[var(--n500)] px-3 py-2 text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-2-4\" data-name=\"step continue to next action label\">Continuar a fechas</span>\n</div>\n<!-- 3 · Fechas -->\n<div class=\"flex flex-col border-r border-[var(--n300)] p-5\" data-kid=\"1-1-1-3\" data-name=\"booking step 3 dates card\">\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-3-1\" data-name=\"step header label row\">\n<span class=\"text-[20px] leading-none text-[var(--accent)]\" data-kid=\"1-1-1-3-1-1\" data-name=\"step number badge\" style=\"font-family: var(--display); font-weight: 600; font-variant-numeric: tabular-nums\">3</span>\n<span class=\"text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-3-1-2\" data-name=\"step title text\">Fechas</span>\n</div>\n<p class=\"mt-4 text-[14px] leading-snug text-[var(--n600)]\" data-kid=\"1-1-1-3-2\" data-name=\"step detail date range\">15/11 al 18/11</p>\n<p class=\"mt-1 text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-3-3\" data-name=\"step detail nights and beds free\">3 noches, 3 camas libres</p>\n<span class=\"mt-auto inline-flex items-center justify-center rounded-[8px] border border-[var(--n500)] px-3 py-2 text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-3-4\" data-name=\"step continue to next action label\">Continuar a datos</span>\n</div>\n<!-- 4 · Datos -->\n<div class=\"flex flex-col border-r border-[var(--n300)] p-5\" data-kid=\"1-1-1-4\" data-name=\"booking step 4 data card\">\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-4-1\" data-name=\"step header label row\">\n<span class=\"text-[20px] leading-none text-[var(--accent)]\" data-kid=\"1-1-1-4-1-1\" data-name=\"step number badge\" style=\"font-family: var(--display); font-weight: 600; font-variant-numeric: tabular-nums\">4</span>\n<span class=\"text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-4-1-2\" data-name=\"step title text\">Datos</span>\n</div>\n<p class=\"mt-4 text-[14px] leading-snug text-[var(--n600)]\" data-kid=\"1-1-1-4-2\" data-name=\"step detail institution field\">Institución</p>\n<p class=\"mt-1 text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-4-3\" data-name=\"step detail responsible and ID fields\">Responsable, DNI y celular</p>\n<span class=\"mt-auto inline-flex items-center justify-center rounded-[8px] border border-[var(--n500)] px-3 py-2 text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-4-4\" data-name=\"confirm reservation action label\">Confirmar reserva</span>\n</div>\n<!-- Confirmación -->\n<div class=\"flex flex-col bg-[var(--sunken)] p-5\" data-kid=\"1-1-1-5\" data-name=\"booking confirmation step card\">\n<div class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-5-1\" data-name=\"step header label row\">\n<svg aria-hidden=\"true\" class=\"h-[18px] w-[18px] self-center text-[var(--green)]\" data-kid=\"1-1-1-5-1-1\" data-name=\"checkmark circle icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n<path d=\"m9 12 2 2 4-4\"></path>\n</svg>\n<span class=\"text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-5-1-2\" data-name=\"step title text\">Confirmación</span>\n</div>\n<span class=\"mt-3 inline-flex items-center gap-2 self-start rounded-[8px] bg-[var(--warning-soft)] px-3 py-1 text-[14px] font-bold leading-snug text-[var(--warning)]\" data-kid=\"1-1-1-5-2\" data-name=\"awaiting payment proof status badge\">\n<span class=\"h-[6px] w-[6px] rounded-full bg-current\" data-kid=\"1-1-1-5-2-1\" data-name=\"status badge dot indicator\"></span>\n          Esperando comprobante\n        </span>\n<p class=\"mt-3 text-[20px] leading-tight\" data-kid=\"1-1-1-5-3\" data-name=\"confirmation reservation number\" style=\"font-family: var(--display); font-weight: 600; letter-spacing: 0.03em; font-variant-numeric: tabular-nums\">R-248715</p>\n<p class=\"mt-1 text-[14px] leading-snug text-[var(--n600)]\" data-kid=\"1-1-1-5-4\" data-name=\"proof upload deadline text\">48 h para subir el comprobante</p>\n<span class=\"mt-auto inline-flex items-center justify-center gap-2 rounded-[8px] bg-[var(--accent)] px-3 py-2 text-[14px] font-bold leading-snug\" data-kid=\"1-1-1-5-5\" data-name=\"primary upload proof button\" style=\"color: #fcf9f2\">\n<svg aria-hidden=\"true\" class=\"h-[18px] w-[18px]\" data-kid=\"1-1-1-5-5-1\" data-name=\"upload arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.75\" viewbox=\"0 0 24 24\">\n<path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n<path d=\"M17 8l-5-5-5 5\"></path>\n<path d=\"M12 3v12\"></path>\n</svg>\n          Cargar comprobante\n        </span>\n</div>\n</div>\n</div>\n</div>\n",
