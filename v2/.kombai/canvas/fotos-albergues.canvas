    "var_7142b79f44ee": {
      "type": "variant",
      "label": "Franja de fotos a lo ancho",
      "parentId": "var_9f1fe07f2593",
      "themeId": null,
      "rect": {
        "x": 1080,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n  @import url(\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;700&family=Source+Serif+4:opsz,wght@8..60,600&display=swap\");\n\n  :root {\n    --ff-ui: \"Manrope\", system-ui, \"Segoe UI\", Roboto, Arial, sans-serif;\n    --ff-display: \"Source Serif 4\", \"Iowan Old Style\", Georgia, serif;\n    --fw-bold: 700;\n    --fw-display: 600;\n    --c-neutral-50: #fcf9f2;\n    --c-neutral-100: #f6f0e5;\n    --c-neutral-200: #e9e1d3;\n    --c-neutral-300: #d6cbb8;\n    --c-neutral-500: #8e8474;\n    --c-neutral-600: #6b6355;\n    --c-neutral-700: #4c463d;\n    --c-neutral-900: #2c2622;\n    --c-white: #ffffff;\n    --c-accent-600: #a84c27;\n    --c-page: var(--c-neutral-50);\n    --c-surface: var(--c-white);\n    --c-surface-sunken: var(--c-neutral-100);\n    --c-text: var(--c-neutral-900);\n    --c-text-subtle: var(--c-neutral-700);\n    --c-text-muted: var(--c-neutral-600);\n    --c-border: var(--c-neutral-300);\n    --c-accent: var(--c-accent-600);\n    --fs-200: 0.875rem;\n    --fs-500: 1.5rem;\n    --lh-snug: 1.32;\n    --ls-tight: -0.015em;\n    --sp-1: 4px;\n    --sp-2: 8px;\n    --sp-3: 12px;\n    --sp-4: 16px;\n    --sp-6: 24px;\n    --sp-8: 32px;\n    --radius-sm: 8px;\n    --bw: 1px;\n    --tap-min: 44px;\n    --container-max: 1200px;\n    --gutter: 32px;\n  }\n\n  body {\n    margin: 0;\n    background-color: var(--c-page);\n    color: var(--c-text);\n    font-family: var(--ff-ui);\n  }\n\n  .container {\n    width: 100%;\n    max-width: var(--container-max);\n    margin-inline: auto;\n    padding-inline: var(--gutter);\n  }\n\n  .icon {\n    width: 20px;\n    height: 20px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.75;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  /* ---- Sección: encabezado como el resto de la home ---- */\n  .franja {\n    padding-block: var(--sp-8);\n    border-top: var(--bw) solid var(--c-border);\n    margin-top: var(--sp-8);\n  }\n\n  .franja__head {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: var(--sp-2) var(--sp-6);\n    margin-bottom: var(--sp-6);\n  }\n\n  .franja__titulo {\n    margin: 0;\n    font-family: var(--ff-display);\n    font-size: var(--fs-500);\n    font-weight: var(--fw-display);\n    line-height: var(--lh-snug);\n    letter-spacing: var(--ls-tight);\n  }\n\n  .franja__link {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--sp-1);\n    min-height: var(--tap-min);\n    color: var(--c-accent);\n    font-size: var(--fs-200);\n    font-weight: var(--fw-bold);\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  /* ---- La tira ----\n     Sangra a los dos bordes de la ventana: el primera foto arranca en el borde\n     y la última queda cortada, que es la única señal de \"hay más\" que no\n     necesita flechas ni indicadores. El desplazamiento es nativo: en el\n     teléfono el dedo mueve la tira, en escritorio la rueda horizontal o el\n     trackpad. */\n  .tira {\n    display: flex;\n    gap: var(--sp-3);\n    margin: 0;\n    padding: 0 0 var(--sp-2);\n    overflow-x: auto;\n    overscroll-behavior-x: contain;\n    scroll-snap-type: x mandatory;\n    scroll-padding-inline-start: var(--gutter);\n    list-style: none;\n    scrollbar-width: none;\n  }\n\n  .tira::-webkit-scrollbar {\n    display: none;\n  }\n\n  .tira__item {\n    position: relative;\n    flex: 0 0 auto;\n    height: 260px;\n    overflow: hidden;\n    background-color: var(--c-neutral-200);\n    scroll-snap-align: start;\n  }\n\n  .tira__item:first-child {\n    margin-inline-start: var(--gutter);\n  }\n\n  .tira__item:last-child {\n    margin-inline-end: var(--gutter);\n  }\n\n  .tira__item img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  /* El nombre del albergue ancla la foto: sin eso, la tira es un carrusel de\n     lugares sin dueño. Es dato, no adorno. */\n  .tira__nombre {\n    position: absolute;\n    left: var(--sp-3);\n    bottom: var(--sp-3);\n    display: inline-flex;\n    align-items: center;\n    gap: var(--sp-2);\n    padding: 2px var(--sp-2);\n    background-color: var(--c-surface);\n    border: var(--bw) solid var(--c-border);\n    border-radius: var(--radius-sm);\n    color: var(--c-text);\n    font-size: var(--fs-200);\n    font-weight: var(--fw-bold);\n    line-height: var(--lh-snug);\n  }\n\n  .ancho-430 {\n    width: 430px;\n  }\n\n  .ancho-360 {\n    width: 360px;\n  }\n\n  .ancho-300 {\n    width: 300px;\n  }\n</style>\n<section class=\"franja\" data-kid=\"1\" data-name=\"photo strip section\">\n<div class=\"container\" data-kid=\"1-1\" data-name=\"section content container\">\n<div class=\"franja__head\" data-kid=\"1-1-1\" data-name=\"section heading row\">\n<h2 class=\"franja__titulo\" data-kid=\"1-1-1-1\" data-name=\"section title heading\">Los predios, en fotos</h2>\n<span class=\"franja__link\" data-kid=\"1-1-1-2\" data-name=\"view all shelters link\">\n        Ver los 5 albergues\n        <svg aria-hidden=\"true\" class=\"icon\" data-kid=\"1-1-1-2-1\" data-name=\"right arrow icon\" viewbox=\"0 0 24 24\"><path d=\"M5 12h14M12 5l7 7-7 7\"></path></svg>\n</span>\n</div>\n</div>\n<ul aria-label=\"Fotos de los albergues\" class=\"tira\" data-kid=\"1-2\" data-name=\"horizontal scroll photo strip\">\n<li class=\"tira__item ancho-430\" data-kid=\"1-2-1\" data-name=\"shelter photo card (wide)\">\n<img alt=\"Pileta del albergue Maestro José Fierro con personas bañándose\" data-kid=\"1-2-1-1\" data-name=\"shelter pool photo\" decoding=\"async\" height=\"853\" src=\"/api/local/images/assets/img/maestro/03.jpeg\" width=\"1280\"/>\n<span class=\"tira__nombre\" data-kid=\"1-2-1-2\" data-name=\"shelter name label\">Maestro José Fierro</span>\n</li>\n<li class=\"tira__item ancho-300\" data-kid=\"1-2-2\" data-name=\"shelter photo card (narrow)\">\n<img alt=\"Mesa bajo el monte, en el predio del albergue Tinku Huasi\" data-kid=\"1-2-2-1\" data-name=\"shelter outdoor table photo\" decoding=\"async\" height=\"394\" loading=\"lazy\" src=\"/api/local/images/assets/img/tinku/03.jpg\" width=\"680\"/>\n<span class=\"tira__nombre\" data-kid=\"1-2-2-2\" data-name=\"shelter name label\">Tinku Huasi</span>\n</li>\n<li class=\"tira__item ancho-360\" data-kid=\"1-2-3\" data-name=\"shelter photo card (medium)\">\n<img alt=\"Carpas entre los pinos del albergue Alto Verde\" data-kid=\"1-2-3-1\" data-name=\"shelter tents photo\" decoding=\"async\" height=\"500\" loading=\"lazy\" src=\"/api/local/images/assets/img/altoverde/03.jpg\" width=\"750\"/>\n<span class=\"tira__nombre\" data-kid=\"1-2-3-2\" data-name=\"shelter name label\">Alto Verde</span>\n</li>\n<li class=\"tira__item ancho-300\" data-kid=\"1-2-4\" data-name=\"shelter photo card (narrow)\">\n<img alt=\"Árbol grande con un banco, en el predio del albergue Aquilina Soldati\" data-kid=\"1-2-4-1\" data-name=\"shelter tree and bench photo\" decoding=\"async\" height=\"426\" loading=\"lazy\" src=\"/api/local/images/assets/img/aquilina/02.jpg\" width=\"568\"/>\n<span class=\"tira__nombre\" data-kid=\"1-2-4-2\" data-name=\"shelter name label\">Aquilina Soldati</span>\n</li>\n<li class=\"tira__item ancho-430\" data-kid=\"1-2-5\" data-name=\"shelter photo card (wide)\">\n<img alt=\"Predio con carpas del albergue Maestro José Fierro\" data-kid=\"1-2-5-1\" data-name=\"shelter campground photo\" decoding=\"async\" height=\"800\" loading=\"lazy\" src=\"/api/local/images/assets/img/maestro/02.jpg\" width=\"1200\"/>\n<span class=\"tira__nombre\" data-kid=\"1-2-5-2\" data-name=\"shelter name label\">Maestro José Fierro</span>\n</li>\n<li class=\"tira__item ancho-300\" data-kid=\"1-2-6\" data-name=\"shelter photo card (narrow)\">\n<img alt=\"Ingreso al Centro Universitario Ing. Roberto Herrera\" data-kid=\"1-2-6-1\" data-name=\"university center entrance photo\" decoding=\"async\" height=\"447\" loading=\"lazy\" src=\"/api/local/images/assets/img/albergue-unt/02.jpg\" width=\"447\"/>\n<span class=\"tira__nombre\" data-kid=\"1-2-6-2\" data-name=\"shelter name label\">Quinta Agronómica</span>\n</li>\n<li class=\"tira__item ancho-360\" data-kid=\"1-2-7\" data-name=\"shelter photo card (medium)\">\n<img alt=\"Portón de entrada del albergue Maestro José Fierro\" data-kid=\"1-2-7-1\" data-name=\"shelter entrance gate photo\" decoding=\"async\" height=\"492\" loading=\"lazy\" src=\"/api/local/images/assets/img/maestro/04.jpeg\" width=\"819\"/>\n<span class=\"tira__nombre\" data-kid=\"1-2-7-2\" data-name=\"shelter name label\">Maestro José Fierro</span>\n</li>\n</ul>\n</section>\n",
