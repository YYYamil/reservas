  "nodes": {
    "var_9f1fe07f2593": {
      "type": "variant",
      "label": "Ficha con galería de 4 fotos",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 980,
        "h": 0
      },
      "html": "<style>\n  @import url(\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;700&family=Source+Serif+4:opsz,wght@8..60,600&display=swap\");\n\n  :root {\n    --ff-ui: \"Manrope\", system-ui, \"Segoe UI\", Roboto, Arial, sans-serif;\n    --ff-display: \"Source Serif 4\", \"Iowan Old Style\", Georgia, serif;\n    --fw-bold: 700;\n    --fw-display: 600;\n    --c-neutral-50: #fcf9f2;\n    --c-neutral-100: #f6f0e5;\n    --c-neutral-200: #e9e1d3;\n    --c-neutral-300: #d6cbb8;\n    --c-neutral-500: #8e8474;\n    --c-neutral-600: #6b6355;\n    --c-neutral-700: #4c463d;\n    --c-neutral-900: #2c2622;\n    --c-white: #ffffff;\n    --c-accent-600: #a84c27;\n    --c-accent-700: #8f4020;\n    --c-page: var(--c-neutral-50);\n    --c-surface: var(--c-white);\n    --c-surface-sunken: var(--c-neutral-100);\n    --c-text: var(--c-neutral-900);\n    --c-text-subtle: var(--c-neutral-700);\n    --c-text-muted: var(--c-neutral-600);\n    --c-text-inverse: var(--c-neutral-50);\n    --c-border: var(--c-neutral-300);\n    --c-border-control: var(--c-neutral-500);\n    --c-accent: var(--c-accent-600);\n    --c-accent-hover: var(--c-accent-700);\n    --c-focus: var(--c-accent);\n    --c-scrim: rgba(44, 38, 34, 0.55);\n    --fs-200: 0.875rem;\n    --fs-300: 1rem;\n    --fs-400: 1.125rem;\n    --fs-500: 1.5rem;\n    --lh-snug: 1.32;\n    --lh-body: 1.55;\n    --ls-tight: -0.015em;\n    --sp-1: 4px;\n    --sp-2: 8px;\n    --sp-3: 12px;\n    --sp-4: 16px;\n    --sp-6: 24px;\n    --radius-sm: 8px;\n    --radius-md: 12px;\n    --radius-lg: 20px;\n    --bw: 1px;\n    --tap-min: 44px;\n    --control-h-sm: 44px;\n    --control-px-sm: 12px;\n    --shadow-2: 0 8px 24px rgba(44, 38, 34, 0.1);\n  }\n\n  body {\n    margin: 0;\n    background-color: var(--c-neutral-900);\n    font-family: var(--ff-ui);\n    color: var(--c-text);\n  }\n\n  .scrim {\n    min-height: 100vh;\n    display: grid;\n    place-items: center;\n    padding: var(--sp-6);\n    background-color: var(--c-scrim);\n  }\n\n  .panel {\n    width: 100%;\n    max-width: 40rem;\n    overflow: hidden;\n    background-color: var(--c-page);\n    border: var(--bw) solid var(--c-border);\n    border-radius: var(--radius-lg);\n    box-shadow: var(--shadow-2);\n  }\n\n  .panel__head {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: var(--sp-3);\n    padding: var(--sp-4) var(--sp-6);\n    border-bottom: var(--bw) solid var(--c-border);\n  }\n\n  .panel__title {\n    margin: 0;\n    font-family: var(--ff-display);\n    font-size: var(--fs-500);\n    font-weight: var(--fw-display);\n    line-height: var(--lh-snug);\n    letter-spacing: var(--ls-tight);\n  }\n\n  .panel__close {\n    display: inline-flex;\n    flex: none;\n    align-items: center;\n    justify-content: center;\n    width: var(--tap-min);\n    height: var(--tap-min);\n    background-color: var(--c-surface);\n    border: var(--bw) solid var(--c-border-control);\n    border-radius: var(--radius-sm);\n  }\n\n  .icon {\n    width: 24px;\n    height: 24px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.75;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .icon--sm {\n    width: 20px;\n    height: 20px;\n  }\n\n  /* ---- Galería: reemplaza la banda de una sola foto ----\n     La foto grande mantiene el 3:2 de la tarjeta y las tres restantes van\n     debajo como tira: se ven las cuatro sin gesto y sin controles. */\n  .galeria {\n    display: grid;\n    gap: var(--sp-2);\n    padding: var(--sp-2);\n    background-color: var(--c-surface-sunken);\n    border-bottom: var(--bw) solid var(--c-border);\n  }\n\n  .galeria__principal {\n    position: relative;\n    height: 232px;\n    overflow: hidden;\n    border-radius: var(--radius-md);\n    background-color: var(--c-neutral-200);\n  }\n\n  .galeria__principal img,\n  .galeria__tira img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .galeria__tira {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: var(--sp-2);\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .galeria__tira li {\n    position: relative;\n    aspect-ratio: 3 / 2;\n    overflow: hidden;\n    border-radius: var(--radius-sm);\n    background-color: var(--c-neutral-200);\n  }\n\n  .panel__body {\n    display: grid;\n    gap: var(--sp-6);\n    padding: var(--sp-6);\n  }\n\n  .facts {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: var(--sp-4);\n    margin: 0;\n  }\n\n  .fact {\n    display: grid;\n    gap: var(--sp-1);\n  }\n\n  .fact dt {\n    color: var(--c-text-muted);\n    font-size: var(--fs-200);\n    line-height: var(--lh-snug);\n  }\n\n  .fact dd {\n    margin: 0;\n    font-size: var(--fs-400);\n    font-weight: var(--fw-bold);\n    font-variant-numeric: tabular-nums;\n  }\n\n  .features {\n    display: grid;\n    gap: var(--sp-2);\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .features li {\n    display: flex;\n    align-items: flex-start;\n    gap: var(--sp-2);\n    color: var(--c-text-subtle);\n    font-size: var(--fs-200);\n    line-height: var(--lh-body);\n  }\n\n  .features .icon {\n    margin-top: 2px;\n    color: var(--c-accent);\n  }\n\n  .texto {\n    margin: 0;\n    color: var(--c-text-muted);\n    font-size: var(--fs-200);\n    line-height: var(--lh-body);\n  }\n\n  .panel__foot {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: var(--sp-2);\n    padding: var(--sp-4) var(--sp-6);\n    border-top: var(--bw) solid var(--c-border);\n  }\n\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: var(--sp-1);\n    min-height: var(--control-h-sm);\n    padding-inline: var(--control-px-sm);\n    border: var(--bw) solid transparent;\n    border-radius: var(--radius-sm);\n    font-family: var(--ff-ui);\n    font-size: var(--fs-200);\n    font-weight: var(--fw-bold);\n    line-height: 1;\n    text-decoration: none;\n    white-space: nowrap;\n  }\n\n  .btn--primary {\n    background-color: var(--c-accent);\n    border-color: var(--c-accent);\n    color: var(--c-text-inverse);\n  }\n\n  .btn--ghost {\n    background-color: transparent;\n    border-color: transparent;\n    color: var(--c-text-subtle);\n  }\n\n  .link {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--sp-1);\n    min-height: var(--tap-min);\n    margin-inline-end: auto;\n    color: var(--c-accent);\n    font-size: var(--fs-200);\n    font-weight: var(--fw-bold);\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n</style>\n<div class=\"scrim\" data-kid=\"1\" data-name=\"dialog backdrop scrim overlay\">\n<div aria-labelledby=\"ficha-titulo\" aria-modal=\"true\" class=\"panel\" data-kid=\"1-1\" data-name=\"accommodation detail dialog panel\" role=\"dialog\">\n<header class=\"panel__head\" data-kid=\"1-1-1\" data-name=\"panel header bar\">\n<h2 class=\"panel__title\" data-kid=\"1-1-1-1\" data-name=\"dialog title with accommodation name\" id=\"ficha-titulo\">Maestro José Fierro</h2>\n<span aria-hidden=\"true\" class=\"panel__close\" data-kid=\"1-1-1-2\" data-name=\"close button\">\n<svg class=\"icon\" data-kid=\"1-1-1-2-1\" data-name=\"close X icon\" viewbox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"></path></svg>\n</span>\n</header>\n<div class=\"galeria\" data-kid=\"1-1-2\" data-name=\"photo gallery section\">\n<div class=\"galeria__principal\" data-kid=\"1-1-2-1\" data-name=\"main gallery image frame\">\n<img alt=\"Edificio principal del albergue Maestro José Fierro entre palmeras\" data-kid=\"1-1-2-1-1\" data-name=\"main hero photo of building\" decoding=\"async\" height=\"380\" src=\"/api/local/images/assets/img/maestro/01.jpg\" width=\"676\"/>\n</div>\n<ul class=\"galeria__tira\" data-kid=\"1-1-2-2\" data-name=\"gallery thumbnail strip\">\n<li data-kid=\"1-1-2-2-1\" data-name=\"thumbnail slot with tree and tents photo\">\n<img alt=\"Predio arbolado con carpas del albergue Maestro José Fierro\" data-kid=\"1-1-2-2-1-1\" data-name=\"thumbnail photo of grounds\" decoding=\"async\" height=\"800\" loading=\"lazy\" src=\"/api/local/images/assets/img/maestro/02.jpg\" width=\"1200\"/>\n</li>\n<li data-kid=\"1-1-2-2-2\" data-name=\"thumbnail slot with pool photo\">\n<img alt=\"Pileta con bañistas del albergue Maestro José Fierro\" data-kid=\"1-1-2-2-2-1\" data-name=\"thumbnail photo of swimming pool\" decoding=\"async\" height=\"853\" loading=\"lazy\" src=\"/api/local/images/assets/img/maestro/03.jpeg\" width=\"1280\"/>\n</li>\n<li data-kid=\"1-1-2-2-3\" data-name=\"thumbnail slot with gate photo\">\n<img alt=\"Portón de entrada del albergue Maestro José Fierro\" data-kid=\"1-1-2-2-3-1\" data-name=\"thumbnail photo of entrance gate\" decoding=\"async\" height=\"492\" loading=\"lazy\" src=\"/api/local/images/assets/img/maestro/04.jpeg\" width=\"819\"/>\n</li>\n</ul>\n</div>\n<div class=\"panel__body\" data-kid=\"1-1-3\" data-name=\"panel body content\">\n<dl class=\"facts\" data-kid=\"1-1-3-1\" data-name=\"facts grid container\">\n<div class=\"fact\" data-kid=\"1-1-3-1-1\" data-name=\"bed count stat\">\n<dt data-kid=\"1-1-3-1-1-1\" data-name='best-before stat label \"Camas\"'>Camas</dt>\n<dd data-kid=\"1-1-3-1-1-2\" data-name='best-before stat value \"92\"'>92</dd>\n</div>\n<div class=\"fact\" data-kid=\"1-1-3-1-2\" data-name=\"day-visit slots stat\">\n<dt data-kid=\"1-1-3-1-2-1\" data-name=\"day-visit slots stat label\">Lugares en visita</dt>\n<dd data-kid=\"1-1-3-1-2-2\" data-name='day-visit slots stat value \"150\"'>150</dd>\n</div>\n<div class=\"fact\" data-kid=\"1-1-3-1-3\" data-name=\"day-visit price stat\">\n<dt data-kid=\"1-1-3-1-3-1\" data-name=\"day-visit price stat label\">Visita de un día</dt>\n<dd data-kid=\"1-1-3-1-3-2\" data-name=\"day-visit price stat value\">$2.000</dd>\n</div>\n<div class=\"fact\" data-kid=\"1-1-3-1-4\" data-name=\"bed per night price stat\">\n<dt data-kid=\"1-1-3-1-4-1\" data-name=\"bed per night price stat label\">Cama por noche</dt>\n<dd data-kid=\"1-1-3-1-4-2\" data-name=\"bed per night price stat value\">$5.000</dd>\n</div>\n</dl>\n<ul class=\"features\" data-kid=\"1-1-3-2\" data-name=\"features feature list\">\n<li data-kid=\"1-1-3-2-1\" data-name=\"feature row: dining room capacity\">\n<svg class=\"icon icon--sm\" data-kid=\"1-1-3-2-1-1\" data-name=\"checkmark bullet icon\" viewbox=\"0 0 24 24\"><path d=\"m5 12 5 5 9-9\"></path></svg>\n          Comedor con capacidad para 150 personas.\n        </li>\n<li data-kid=\"1-1-3-2-2\" data-name=\"feature row: shared dorms\">\n<svg class=\"icon icon--sm\" data-kid=\"1-1-3-2-2-1\" data-name=\"checkmark bullet icon\" viewbox=\"0 0 24 24\"><path d=\"m5 12 5 5 9-9\"></path></svg>\n          Dormitorios compartidos en 6 habitaciones.\n        </li>\n<li data-kid=\"1-1-3-2-3\" data-name=\"feature row: recreational areas\">\n<svg class=\"icon icon--sm\" data-kid=\"1-1-3-2-3-1\" data-name=\"checkmark bullet icon\" viewbox=\"0 0 24 24\"><path d=\"m5 12 5 5 9-9\"></path></svg>\n          Áreas recreativas iluminadas.\n        </li>\n</ul>\n<p class=\"texto\" data-kid=\"1-1-3-3\" data-name=\"location description text\">\n        El Albergue Escolar Maestro José Fierro se encuentra ubicado al sureste de\n        la ciudad capital.\n      </p>\n</div>\n<footer class=\"panel__foot\" data-kid=\"1-1-4\" data-name=\"panel footer with actions\">\n<span class=\"link\" data-kid=\"1-1-4-1\" data-name=\"view map link\">\n        Ver mapa\n        <svg class=\"icon icon--sm\" data-kid=\"1-1-4-1-1\" data-name=\"arrow icon for map link\" viewbox=\"0 0 24 24\"><path d=\"M5 12h14M12 5l7 7-7 7\"></path></svg>\n</span>\n<span class=\"btn btn--ghost\" data-kid=\"1-1-4-2\" data-name=\"regulations ghost button\">\n<svg class=\"icon icon--sm\" data-kid=\"1-1-4-2-1\" data-name=\"document icon\" viewbox=\"0 0 24 24\"><path d=\"M14 3v4a1 1 0 0 0 1 1h4M5 3h9l5 5v13H5z\"></path></svg>\n        Reglamento\n      </span>\n<span class=\"btn btn--primary\" data-kid=\"1-1-4-3\" data-name=\"primary book button\">Reservar</span>\n</footer>\n</div>\n</div>\n",
