    "var_d31fd57c9e56": {
      "type": "variant",
      "label": "Nav compacto 390 con sello",
      "parentId": "var_7ed99dcbbdb3",
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n  @import url(\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;700&family=Source+Serif+4:opsz,wght@8..60,600&display=swap\");\n\n  :root {\n    --ff-ui: \"Manrope\", system-ui, \"Segoe UI\", Roboto, Arial, sans-serif;\n    --ff-display: \"Source Serif 4\", \"Iowan Old Style\", Georgia, serif;\n    --fw-bold: 700;\n    --fw-display: 600;\n    --c-neutral-50: #fcf9f2;\n    --c-neutral-100: #f6f0e5;\n    --c-neutral-300: #d6cbb8;\n    --c-neutral-500: #8e8474;\n    --c-neutral-700: #4c463d;\n    --c-neutral-900: #2c2622;\n    --c-white: #ffffff;\n    --c-accent-600: #a84c27;\n    --c-page: var(--c-neutral-50);\n    --c-surface: var(--c-white);\n    --c-surface-sunken: var(--c-neutral-100);\n    --c-text: var(--c-neutral-900);\n    --c-text-subtle: var(--c-neutral-700);\n    --c-text-inverse: var(--c-neutral-50);\n    --c-border: var(--c-neutral-300);\n    --c-border-control: var(--c-neutral-500);\n    --c-accent: var(--c-accent-600);\n    --fs-200: 0.875rem;\n    --fs-300: 1rem;\n    --sp-1: 4px;\n    --sp-2: 8px;\n    --sp-3: 12px;\n    --radius-sm: 8px;\n    --bw: 1px;\n    --tap-min: 44px;\n    --control-h-sm: 44px;\n    --control-px-sm: 12px;\n    --control-gap: 8px;\n    --gutter: 16px;\n    --nav-h: 64px;\n    --nav-gap: 12px;\n    --z-nav: 20;\n  }\n\n  body {\n    margin: 0;\n    background-color: var(--c-page);\n    color: var(--c-text);\n    font-family: var(--ff-ui);\n  }\n\n  .container {\n    width: 100%;\n    max-width: 1200px;\n    margin-inline: auto;\n    padding-inline: var(--gutter);\n  }\n\n  .icon {\n    width: 24px;\n    height: 24px;\n    flex: none;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.75;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .nav {\n    position: sticky;\n    top: 0;\n    z-index: var(--z-nav);\n    background-color: var(--c-page);\n    border-bottom: var(--bw) solid var(--c-border);\n  }\n\n  .nav__bar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: var(--nav-gap);\n    min-height: var(--nav-h);\n  }\n\n  /* En compacto el lockup completo no entra: el titular se cae y queda sello\n     más nombre del producto, que es lo que nombra el servicio. */\n  .brand {\n    display: inline-flex;\n    flex-direction: row;\n    align-items: center;\n    gap: var(--sp-2);\n    min-height: var(--tap-min);\n    min-width: 0;\n    color: var(--c-text);\n    text-decoration: none;\n  }\n\n  .brand__mark {\n    display: block;\n    height: 34px;\n    width: auto;\n    flex: none;\n  }\n\n  .brand__name {\n    font-family: var(--ff-display);\n    font-size: var(--fs-300);\n    font-weight: var(--fw-display);\n    line-height: 1.1;\n    letter-spacing: -0.015em;\n    white-space: nowrap;\n  }\n\n  .nav__actions {\n    display: flex;\n    align-items: center;\n    gap: var(--sp-2);\n    flex: none;\n  }\n\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: var(--control-gap);\n    min-height: var(--control-h-sm);\n    padding-inline: var(--control-px-sm);\n    border: var(--bw) solid transparent;\n    border-radius: var(--radius-sm);\n    font-family: var(--ff-ui);\n    font-size: var(--fs-200);\n    font-weight: var(--fw-bold);\n    line-height: 1;\n    text-decoration: none;\n    white-space: nowrap;\n  }\n\n  .btn--primary {\n    background-color: var(--c-accent);\n    border-color: var(--c-accent);\n    color: var(--c-text-inverse);\n  }\n\n  .nav__toggle {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--tap-min);\n    height: var(--tap-min);\n    background-color: var(--c-surface);\n    border: var(--bw) solid var(--c-border-control);\n    border-radius: var(--radius-sm);\n    color: var(--c-text);\n    list-style: none;\n  }\n</style>\n<header class=\"nav\" data-kid=\"1\" data-name=\"sticky site navigation header\">\n<div class=\"container nav__bar\" data-kid=\"1-1\" data-name=\"navigation bar container\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<img alt=\"Universidad Nacional de Tucumán\" class=\"brand__mark\" data-kid=\"1-1-1-1\" data-name=\"brand seal logo image\" decoding=\"async\" height=\"118\" src=\"/api/local/images/assets/img/brand/unt-sello.png\" width=\"96\"/>\n<span class=\"brand__name\" data-kid=\"1-1-1-2\" data-name=\"product name text\">Albergues recreativos</span>\n</a>\n<div class=\"nav__actions\" data-kid=\"1-1-2\" data-name=\"navigation actions group\">\n<a class=\"btn btn--primary\" data-kid=\"1-1-2-1\" data-name=\"primary reservar call-to-action button\" href=\"#\">Reservar</a>\n<span class=\"nav__toggle\" data-kid=\"1-1-2-2\" data-name=\"mobile menu toggle button\">\n<svg aria-hidden=\"true\" class=\"icon\" data-kid=\"1-1-2-2-1\" data-name=\"hamburger menu icon\" viewbox=\"0 0 24 24\">\n<path d=\"M4 7h16M4 12h16M4 17h16\"></path>\n</svg>\n</span>\n</div>\n</div>\n</header>\n",
