      },
      "html": "<style>\n  @import url(\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;700&family=Source+Serif+4:opsz,wght@8..60,600&display=swap\");\n\n  :root {\n    --ff-ui: \"Manrope\", system-ui, \"Segoe UI\", Roboto, Arial, sans-serif;\n    --ff-display: \"Source Serif 4\", \"Iowan Old Style\", Georgia, serif;\n    --fw-bold: 700;\n    --fw-display: 600;\n    --c-neutral-50: #fcf9f2;\n    --c-neutral-100: #f6f0e5;\n    --c-neutral-200: #e9e1d3;\n    --c-neutral-300: #d6cbb8;\n    --c-neutral-500: #8e8474;\n    --c-neutral-600: #6b6355;\n    --c-neutral-700: #4c463d;\n    --c-neutral-900: #2c2622;\n    --c-white: #ffffff;\n    --c-accent-600: #a84c27;\n    --c-accent-700: #8f4020;\n    --c-accent-800: #7a3319;\n    --c-page: var(--c-neutral-50);\n    --c-surface: var(--c-white);\n    --c-surface-sunken: var(--c-neutral-100);\n    --c-text: var(--c-neutral-900);\n    --c-text-subtle: var(--c-neutral-700);\n    --c-text-muted: var(--c-neutral-600);\n    --c-text-inverse: var(--c-neutral-50);\n    --c-border: var(--c-neutral-300);\n    --c-border-control: var(--c-neutral-500);\n    --c-accent: var(--c-accent-600);\n    --c-accent-hover: var(--c-accent-700);\n    --c-accent-pressed: var(--c-accent-800);\n    --fs-100: 0.75rem;\n    --fs-200: 0.875rem;\n    --fs-300: 1rem;\n    --fs-400: 1.125rem;\n    --sp-1: 4px;\n    --sp-2: 8px;\n    --sp-3: 12px;\n    --sp-4: 16px;\n    --radius-sm: 8px;\n    --bw: 1px;\n    --bw-strong: 2px;\n    --tap-min: 44px;\n    --control-h-sm: 44px;\n    --control-h-md: 48px;\n    --control-px-sm: 12px;\n    --control-gap: 8px;\n    --container-max: 1200px;\n    --gutter: 32px;\n    --nav-h: 64px;\n    --nav-gap: 12px;\n    --dur-1: 150ms;\n    --ease-out: cubic-bezier(0.22, 0.61, 0.36, 1);\n    --z-nav: 20;\n  }\n\n  body {\n    margin: 0;\n    background-color: var(--c-page);\n    color: var(--c-text);\n    font-family: var(--ff-ui);\n  }\n\n  .container {\n    width: 100%;\n    max-width: var(--container-max);\n    margin-inline: auto;\n    padding-inline: var(--gutter);\n  }\n\n  .icon {\n    width: 24px;\n    height: 24px;\n    flex: none;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.75;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .icon--sm {\n    width: 20px;\n    height: 20px;\n  }\n\n  .nav {\n    position: sticky;\n    top: 0;\n    z-index: var(--z-nav);\n    background-color: var(--c-page);\n    border-bottom: var(--bw) solid var(--c-border);\n  }\n\n  .nav__bar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: var(--nav-gap);\n    min-height: var(--nav-h);\n  }\n\n  /* Lockup institucional completo: sello, titular y nombre del producto.\n     La línea del titular va en 12 px, el escalón que el sistema reserva y no\n     usa en texto operativo: es el costo de meter la marca entera en la barra. */\n  .brand {\n    display: inline-flex;\n    flex-direction: row;\n    align-items: center;\n    gap: var(--sp-3);\n    min-height: var(--tap-min);\n    color: var(--c-text);\n    text-decoration: none;\n  }\n\n  .brand__mark {\n    display: block;\n    height: 44px;\n    width: auto;\n    flex: none;\n  }\n\n  .brand__text {\n    display: grid;\n    gap: 2px;\n  }\n\n  .brand__org {\n    color: var(--c-text-muted);\n    font-family: var(--ff-ui);\n    font-size: var(--fs-100);\n    font-weight: var(--fw-bold);\n    line-height: 1.1;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n  }\n\n  .brand__name {\n    font-family: var(--ff-display);\n    font-size: var(--fs-400);\n    font-weight: var(--fw-display);\n    line-height: 1.1;\n    letter-spacing: -0.015em;\n  }\n\n  .nav__links {\n    display: flex;\n    align-items: center;\n    gap: var(--sp-1);\n    margin-inline: auto;\n  }\n\n  .nav__link {\n    display: inline-flex;\n    align-items: center;\n    min-height: var(--tap-min);\n    padding-inline: var(--sp-3);\n    border-radius: var(--radius-sm);\n    color: var(--c-text-subtle);\n    font-size: var(--fs-200);\n    font-weight: var(--fw-bold);\n    text-decoration: none;\n    transition: background-color var(--dur-1) var(--ease-out),\n      color var(--dur-1) var(--ease-out);\n  }\n\n  .nav__link[aria-current=\"page\"] {\n    color: var(--c-text);\n    box-shadow: inset 0 calc(var(--bw-strong) * -1) 0 0 var(--c-accent);\n  }\n\n  .nav__actions {\n    display: flex;\n    align-items: center;\n    gap: var(--sp-2);\n  }\n\n  .btn {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: var(--control-gap);\n    min-height: var(--control-h-md);\n    padding-inline: var(--control-px-sm);\n    border: var(--bw) solid transparent;\n    border-radius: var(--radius-sm);\n    font-family: var(--ff-ui);\n    font-size: var(--fs-300);\n    font-weight: var(--fw-bold);\n    line-height: 1;\n    text-decoration: none;\n    white-space: nowrap;\n  }\n\n  .btn--sm {\n    min-height: var(--control-h-sm);\n    gap: var(--sp-1);\n    font-size: var(--fs-200);\n  }\n\n  .btn--primary {\n    background-color: var(--c-accent);\n    border-color: var(--c-accent);\n    color: var(--c-text-inverse);\n  }\n\n  .btn--ghost {\n    background-color: transparent;\n    border-color: transparent;\n    color: var(--c-text-subtle);\n  }\n\n  .btn__label {\n    display: inline-block;\n  }\n</style>\n<header class=\"nav\" data-kid=\"1\" data-name=\"site header navigation bar\">\n<div class=\"container nav__bar\" data-kid=\"1-1\" data-name=\"nav bar layout container\">\n<a class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<img alt=\"Universidad Nacional de Tucumán\" class=\"brand__mark\" data-kid=\"1-1-1-1\" data-name=\"university seal logo image\" decoding=\"async\" height=\"118\" src=\"/api/local/images/assets/img/brand/unt-sello.png\" width=\"96\"/>\n<span class=\"brand__text\" data-kid=\"1-1-1-2\" data-name=\"brand text block\">\n<span class=\"brand__org\" data-kid=\"1-1-1-2-1\" data-name=\"university name label\">Universidad Nacional de Tucumán</span>\n<span class=\"brand__name\" data-kid=\"1-1-1-2-2\" data-name=\"product name text\">Albergues recreativos</span>\n</span>\n</a>\n<nav aria-label=\"Principal\" class=\"nav__links\" data-kid=\"1-1-2\" data-name=\"primary navigation links\">\n<a aria-current=\"page\" class=\"nav__link\" data-kid=\"1-1-2-1\" data-name=\"active Albergues nav link\" href=\"#\">Albergues</a>\n<a class=\"nav__link\" data-kid=\"1-1-2-2\" data-name=\"Cómo funciona nav link\" href=\"#\">Cómo funciona</a>\n<a class=\"nav__link\" data-kid=\"1-1-2-3\" data-name=\"Ayuda nav link\" href=\"#\">Ayuda</a>\n</nav>\n<div class=\"nav__actions\" data-kid=\"1-1-3\" data-name=\"nav action buttons container\">\n<a class=\"btn btn--ghost btn--sm\" data-kid=\"1-1-3-1\" data-name=\"my reservation ghost button\" href=\"#\">\n<svg aria-hidden=\"true\" class=\"icon icon--sm\" data-kid=\"1-1-3-1-1\" data-name=\"ticket icon\" viewbox=\"0 0 24 24\">\n<path d=\"M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z\"></path>\n<path d=\"M13 5v2M13 11v2M13 17v2\"></path>\n</svg>\n<span class=\"btn__label\" data-kid=\"1-1-3-1-2\" data-name=\"my reservation button label\">Mi reserva</span>\n</a>\n<a class=\"btn btn--primary btn--sm\" data-kid=\"1-1-3-2\" data-name=\"primary book reservation button\" href=\"#\">\n<span class=\"btn__label\" data-kid=\"1-1-3-2-1\" data-name=\"book reservation button label\">Reservar</span>\n</a>\n</div>\n</div>\n</header>\n",
      "comments": [],
